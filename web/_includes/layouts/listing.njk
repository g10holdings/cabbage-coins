---
layout: layouts/dark.njk
templateClass: tmpl-listing
parent: Inventory
---
{# Same structure as the 2026-08 listing redesign (four full-width photos stacked on the left, details on the
   right in this order: title, price, specs, CAC, buttons, PCGS pop, CAC pop, Tony says, video), in the new
   colors and fonts. Under 900px the photos become a swipe carousel. #}
{% set isFeatured = featured and listing.slug.current == featured.slug.current %}
{% set imgq = "&q=90&auto=format&fit=max" %}
{% set photos = listing | listingPhotos %}

<div class="cc26-wrap cc26-listing{% if isFeatured %} cc26-listing--featured{% endif %}">
    <nav class="cc26-crumbs cc26-listing__crumbs" aria-label="Breadcrumb">
        <a href="/">Home</a><span aria-hidden="true">/</span><a href="/inventory/">Inventory</a><span aria-hidden="true">/</span><span class="cc26-crumbs__here" aria-current="page">{{ listing.name }}</span>
    </nav>

    <div class="cc26-lcard">
        {% if isFeatured %}<div class="cc26-lcard__banner"><span aria-hidden="true">★</span> Featured listing <span aria-hidden="true">★</span></div>{% endif %}
        <div class="cc26-lgrid">
            {# ---------- Photos: four large shots, stacked. Click any one for the zoom viewer. ---------- #}
            <div class="cc26-lphotos">
                {% if listing.image.caption %}<p class="cc26-lphotos__caption">“{{ listing.image.caption }}”</p>{% endif %}
                <div class="cc26-lphotos__track" data-carousel-track>
                    {% for src in photos %}
                    <a class="cc26-lphoto" href="{{ src }}" data-zoom="coin" aria-label="Zoom photo {{ loop.index }} of {{ photos.length }}">
                        <img src="{{ src }}?w=1044{{ imgq }}" alt="{{ listing.name }}{% if loop.first %} obverse{% elif loop.index == 2 %} reverse{% else %} in holder, view {{ loop.index0 - 1 }}{% endif %}"{% if not loop.first %} loading="lazy"{% endif %} width="1044" height="1044">
                        <span class="cc26-lphoto__zoom" aria-hidden="true"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="11" cy="11" r="7"/><path d="M20 20l-4-4M11 8v6M8 11h6"/></svg></span>
                    </a>
                    {% endfor %}
                </div>
                {% if photos.length > 1 %}
                <div class="cc26-lphotos__nav" data-carousel-nav>
                    {% for src in photos %}
                    <button type="button" class="cc26-lphotos__thumb" data-goto="{{ loop.index0 }}" aria-label="Photo {{ loop.index }}" style="background-image: url('{{ src }}?w=220{{ imgq }}')"></button>
                    {% endfor %}
                </div>
                {% endif %}
            </div>

            {# ---------- Details ---------- #}
            <div class="cc26-linfo">
                <h1 class="cc26-linfo__title">{{ listing.name }}</h1>

                <div class="cc26-linfo__price">
                    {% if listing.sold %}
                    <span class="cc26-linfo__amount is-sold">${{ listing.price | money }}</span>
                    <span class="cc26-status cc26-status--sold">Sold</span>
                    {% else %}
                    <span class="cc26-linfo__amount">${{ listing.price | money }}</span>
                    <span class="cc26-status">Available</span>
                    {% endif %}
                </div>

                <dl class="cc26-specs">
                    <div><dt>Issue</dt><dd>{{ listing.dateshown }}</dd></div>
                    <div><dt>Grading company</dt><dd>{{ listing.gradingCompany }}</dd></div>
                    <div><dt>Certification #</dt><dd>{{ listing.gradenumber | certNumber }}</dd></div>
                    <div><dt>Grade</dt><dd>{{ listing.grade }}</dd></div>
                    <div><dt>PCGS catalog #</dt><dd>{{ listing.pcgsDesignationNumber or listing.pcgsCatalogNumber }}</dd></div>
                </dl>

                {% if listing.cac %}
                <div class="cc26-cacrow">
                    <img src="/assets/img/caccoin.png" alt="CAC verified">
                    <span>CAC verified — green sticker</span>
                </div>
                {% endif %}

                <div class="cc26-linfo__actions">
                    {% if not listing.sold %}
                    <button type="button" class="cc26-btn cc26-btn--gold" data-modal-open="cc26-inquire">
                        <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="M3 7l9 6 9-6"/></svg>
                        <span>Inquire</span>
                    </button>
                    {% else %}
                    <button type="button" class="cc26-btn cc26-btn--gold" data-join-open><span>Looking for one like it?</span></button>
                    {% endif %}
                    {# Phones open their own share sheet; computers get this menu. #}
                    <div class="cc26-share" data-share data-title="{{ listing.name }}">
                        <button type="button" class="cc26-btn cc26-btn--ghost" aria-expanded="false" data-share-toggle>
                            <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><circle cx="18" cy="5" r="3"/><circle cx="6" cy="12" r="3"/><circle cx="18" cy="19" r="3"/><path d="M8.6 13.5l6.8 4M15.4 6.5l-6.8 4"/></svg>
                            <span>Share</span>
                        </button>
                        <div class="cc26-share__menu" data-share-menu hidden>
                            <button type="button" data-share-copy><span>Copy link</span></button>
                            <a data-share-to="facebook" target="_blank" rel="noopener">Facebook</a>
                            <a data-share-to="x" target="_blank" rel="noopener">X</a>
                            <a data-share-to="email">Email</a>
                        </div>
                    </div>
                    <a class="cc26-btn cc26-btn--ghost" href="/selltous/">
                        <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 7v10M9.5 9.5c0-1.2 1.1-2 2.5-2s2.5.8 2.5 2-1.1 1.8-2.5 2.1-2.5.9-2.5 2.1 1.1 2 2.5 2 2.5-.8 2.5-2"/></svg>
                        <span>Have one of these to sell?</span>
                    </a>
                </div>
                {% if listing.sold %}<p class="cc26-muted cc26-linfo__soldnote">This coin has sold. Join the list with your want list and Tony will reach out when a similar coin comes in.</p>{% endif %}

                {# PCGS population: unsold PCGS listings that have it saved (scripts/engine/fill-pcgs-pop.js). #}
                {% if listing.pcgsPop and listing.gradingCompany == "PCGS" and not listing.sold %}
                {% set popData = listing.pcgsPop %}{% include "pcgspop.njk" %}
                {% endif %}
                {# CAC population: its own box, never combined with PCGS (competitors). #}
                {% if listing.cacPop and listing.cacPop.cells and not listing.sold %}
                {% set cacPopData = listing.cacPop %}{% include "cacpop.njk" %}
                {% endif %}

                {% if listing.description %}
                <section class="cc26-tonysays{% if isFeatured %} cc26-tonysays--gold{% endif %}" aria-labelledby="cc26-tonysays-title">
                    <div class="cc26-tonysays__head">
                        <img src="/assets/img/CabbageCoins_Emblem_Small_White.png" alt="">
                        <h2 id="cc26-tonysays-title">Tony says …</h2>
                    </div>
                    <div class="cc26-tonysays__body">{{ listing.description | markdownify | safe }}</div>
                </section>
                {% endif %}

                {# The coin's YouTube Short ("YouTube video" field in Studio). #}
                {% set videoId = listing.youtubeUrl | youtubeId %}
                {% if videoId %}
                <section class="cc26-short" aria-labelledby="cc26-short-title">
                    <h2 id="cc26-short-title">Watch this coin</h2>
                    <div class="cc26-short__frame">
                        <iframe src="https://www.youtube-nocookie.com/embed/{{ videoId }}?rel=0" title="Video of the {{ listing.name }}" loading="lazy" allow="accelerometer; autoplay; encrypted-media; gyroscope; picture-in-picture; web-share" referrerpolicy="strict-origin-when-cross-origin" allowfullscreen></iframe>
                    </div>
                </section>
                {% endif %}
            </div>
        </div>
    </div>
</div>

{# ---------- Keep browsing: the most similar coins in stock (similarListings in .eleventy.js) ---------- #}
{% set similar = collections.listingsNewest | similarListings(listing, 6) %}
{% if similar.length %}
<section class="cc26-wrap cc26-section cc26-section--last">
    <div class="cc26-section__head">
        <div>
            <div class="cc26-eyebrow">Keep browsing</div>
            <h2>Similar coins in the inventory</h2>
        </div>
        <a class="cc26-textlink" href="/inventory/">View the full inventory →</a>
    </div>
    <div class="cc26-grid">
        {% for other in similar %}
        <a class="cc26-card" href="/listings/{{ other.slug.current | slug }}/">
            <span class="cc26-card__img">
                <img src="{{ other.imageUrl }}?w=640{{ imgq }}" alt="{{ other.name }}" loading="lazy">
                {% if other.galleryImageUrl and other.galleryImageUrl[0] %}<img class="cc26-card__back" src="{{ other.galleryImageUrl[0] }}?w=640{{ imgq }}" alt="" loading="lazy">{% endif %}
            </span>
            <span class="cc26-card__meta">
                <span>{{ other.gradingCompany }} {{ other.grade | replace(" CAC", "") }}</span>
                {% if other.cac %}<img src="/assets/img/caccoin.png" alt="CAC approved" class="cc26-cac">{% endif %}
            </span>
            <span class="cc26-card__name">{{ other.name }}</span>
            <span class="cc26-card__price">${{ other.price | money }}</span>
        </a>
        {% endfor %}
    </div>
</section>
{% endif %}

{# ---------- Inquire pop-up: same Formspree form, subject, fields and message as before ---------- #}
{% if not listing.sold %}
<div class="cc26-modal" id="cc26-inquire" hidden>
    <div class="cc26-modal__backdrop" data-modal-close></div>
    <div class="cc26-modal__card" role="dialog" aria-modal="true" aria-labelledby="cc26-inquire-title">
        <div class="cc26-modal__head">
            <img src="{{ listing.imageUrl }}?w=120{{ imgq }}" alt="" class="cc26-modal__coin">
            <div>
                <h2 id="cc26-inquire-title">Inquire about this coin</h2>
                <p>{{ listing.name }}</p>
            </div>
            <button type="button" class="cc26-iconbtn" data-modal-close aria-label="Close">&times;</button>
        </div>
        <form action="https://formspree.io/f/xzdkqbva" method="POST" class="cc26-form" data-replyto>
            <input type="text" name="_gotcha" tabindex="-1" autocomplete="off" aria-hidden="true" style="display:none !important;">
            <input type="hidden" name="_subject" value="Purchase Inquiry - {{ listing.name }}">
            <input type="hidden" name="form_type" value="Coin Purchase Inquiry">
            <div class="cc26-form__two">
                <label>Your name<input type="text" name="name" placeholder="John Smith" required></label>
                <label>Your email<input type="email" name="email" placeholder="john@email.com" required></label>
            </div>
            <label>Phone number (optional)<input type="tel" name="phone" placeholder="(717) 555-1234"></label>
            <label>Message<textarea name="message" rows="6">Hello Tony,
I am interested in purchasing the {{ listing.name }} listed at ${{ listing.price }}.
My preferred payment method is: (Zelle, Venmo, Paypal FF, Check)
Please contact me at your earliest convenience to discuss this purchase.
[please add your phone number here]
Thank you!</textarea></label>
            <label class="cc26-form__check"><input type="checkbox" name="privacypolicy" required> I agree to the <a href="/privacypolicy/" target="_blank">privacy policy</a>.</label>
            <div class="cc26-form__actions">
                <button type="submit" class="cc26-btn cc26-btn--gold">Send inquiry</button>
                <button type="button" class="cc26-btn cc26-btn--ghost" data-modal-close>Cancel</button>
            </div>
        </form>
    </div>
</div>
{% endif %}

<script src="/assets/js/listing2026.js" defer></script>
