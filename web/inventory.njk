---
date: 2022-01-02
eleventyNavigation:
  key: inventory
  order: 1
layout: layouts/dark.njk
tags:
  - nav
navtitle: Inventory
title: Cabbage Coins | Inventory
---
{% set imgq = "&q=90&auto=format&fit=max" %}
<div class="cc26-wrap cc26-wrap--wide cc26-inv">
    <div class="cc26-inv__head">
        <div>
            <div class="cc26-eyebrow">Inventory</div>
            <h1 class="cc26-inv__count" data-inv-count aria-live="polite">{{ (collections.listingsNewest | notArchived).length }} items</h1>
        </div>
        <span class="cc26-muted">Last updated: {{ buildInfo.lastUpdated }}</span>
    </div>

    <div class="cc26-inv__controls">
        <div class="cc26-inv__row">
            <div class="cc26-pills" role="group" aria-label="Filter by type">
                <span class="cc26-pills__label">Type</span>
                <button type="button" class="cc26-pill" data-filter-cat="all" aria-pressed="true">All</button>
                <button type="button" class="cc26-pill" data-filter-cat="Gold" aria-pressed="false">Gold</button>
                <button type="button" class="cc26-pill" data-filter-cat="Silver" aria-pressed="false">Silver</button>
                <button type="button" class="cc26-pill" data-filter-cat="Copper/Bronze" aria-pressed="false">Copper/Bronze</button>
                <button type="button" class="cc26-pill" data-filter-cat="Vintage Ingot" aria-pressed="false">Vintage Ingot</button>
                <button type="button" class="cc26-pill" data-filter-cat="Foreign" aria-pressed="false">Foreign</button>
            </div>
            <label class="cc26-inv__sort">
                <span class="cc26-pills__label">Sort</span>
                <select data-inv-sort>
                    <option value="newest" selected>Newest items</option>
                    <option value="catalog">PCGS catalog #</option>
                    <option value="priceasc">Price (low to high)</option>
                    <option value="pricedsc">Price (high to low)</option>
                </select>
            </label>
        </div>
        <div class="cc26-inv__row">
            <div class="cc26-pills" role="group" aria-label="Filter by grading service">
                <span class="cc26-pills__label">Graded by</span>
                <button type="button" class="cc26-pill" data-filter-cert="all" aria-pressed="true">All</button>
                <button type="button" class="cc26-pill" data-filter-cert="PCGS" aria-pressed="false">PCGS</button>
                <button type="button" class="cc26-pill" data-filter-cert="NGC" aria-pressed="false">NGC</button>
                <button type="button" class="cc26-pill" data-filter-cert="CACG" aria-pressed="false">CACG</button>
                <button type="button" class="cc26-pill" data-filter-cert="Ungraded" aria-pressed="false">Ungraded</button>
            </div>
            <div class="cc26-inv__toggles">
                <label class="cc26-toggle cc26-toggle--cac">
                    <input type="checkbox" data-inv-cac>
                    <img src="/assets/img/caccoin.png" alt="CAC">
                    <span>Only</span>
                </label>
                <label class="cc26-toggle">
                    <input type="checkbox" data-inv-sold checked>
                    <span>Show sold</span>
                </label>
            </div>
        </div>
    </div>

    <div class="cc26-grid cc26-grid--inv" data-inv-grid>
        {# Sold coins move to /past-sales/ 10 days after their sale (isArchived in .eleventy.js; the script re-checks the date). #}
        {% for listing in collections.listingsNewest | notArchived | reverse %}
        <a class="cc26-card{% if listing.sold %} cc26-card--sold{% endif %}" href="/listings/{{ listing.slug.current | slug }}/"
           data-cat="{{ listing.category }}" data-cac="{{ 'true' if listing.cac else 'false' }}" data-cert="{{ listing.gradingCompany }}"
           data-sold="{{ 'true' if listing.sold else 'false' }}"{% if listing.sold %} data-archive-on="{{ listing | archiveOn }}"{% endif %} data-price="{{ listing.price }}" data-catno="{{ listing.pcgsCatalogNumber }}" data-newest="{{ loop.index0 }}">
            <span class="cc26-card__img">
                <img src="{{ listing.imageUrl }}?w=640{{ imgq }}" alt="{{ listing.name }}" loading="lazy">
                {% if listing.galleryImageUrl and listing.galleryImageUrl[0] %}
                <img class="cc26-card__back" src="{{ listing.galleryImageUrl[0] }}?w=640{{ imgq }}" alt="" loading="lazy">
                {% endif %}
                {% if listing.sold %}<span class="cc26-card__sold">Sold</span>{% endif %}
            </span>
            <span class="cc26-card__meta">
                <span>{{ listing.gradingCompany }} {{ listing.grade | replace(" CAC", "") }}</span>
                {% if listing.cac %}<img src="/assets/img/caccoin.png" alt="CAC approved" class="cc26-cac">{% endif %}
            </span>
            <span class="cc26-card__name">{{ listing.name }}</span>
            <span class="cc26-card__price">${{ listing.price | money }}</span>
        </a>
        {% endfor %}
    </div>
    <p class="cc26-inv__empty" data-inv-empty hidden>No coins match those filters right now. <button type="button" class="cc26-textlink cc26-gold" data-join-open>Tell Tony what you're looking for →</button></p>
    <p class="cc26-inv__more"><a class="cc26-textlink" href="/past-sales/">Past sales →</a></p>
</div>
<script src="/assets/js/inventory2026.js" defer></script>
