        </div>
        <div class="cc26-cta__actions">
            <button type="button" class="cc26-btn cc26-btn--gold cc26-btn--lg" data-modal-open="cc26-contact">Contact Tony</button>
            <a class="cc26-textlink" href="tel:17177239505">(717) 723-9505</a>
        </div>
    </div>
</section>

