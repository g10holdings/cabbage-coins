        <rect x="80" y="118" width="46" height="52" rx="2" class="ff2"/>
        <g stroke="#3A3733" stroke-width="2"><line x1="86" y1="128" x2="116" y2="128"/><line x1="86" y1="138" x2="120" y2="138"/><line x1="86" y1="148" x2="110" y2="148"/></g>
