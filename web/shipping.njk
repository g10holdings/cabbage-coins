      <figure>
        <svg viewBox="0 0 200 170" role="img" aria-label="A small shipping box, free from FedEx">
          <polygon points="26,74 136,74 136,148 26,148" class="f l"/>
          <polygon points="26,74 56,52 166,52 136,74" class="f2 l"/>
          <polygon points="136,74 166,52 166,126 136,148" class="f2 l"/>
