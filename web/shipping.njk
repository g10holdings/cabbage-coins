        <rect x="88" y="104" width="40" height="16" rx="8" class="m"/>
        <path d="M172 52 h110 a12 12 0 0 1 12 12 v52 a12 12 0 0 1 -12 12 h-66 l-20 20 v-20 h-24 a12 12 0 0 1 -12 -12 v-52 a12 12 0 0 1 12 -12z" class="f l"/>
