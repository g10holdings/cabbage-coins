{#
  The schedule below is driven entirely by the "Coin Shows" documents in Sanity
  Studio — see `web/_data/coinshows.js` for the query, the month grouping and
  the retention rule (a show stays until the end of the month AFTER it ends).
  Add or edit shows in Studio, then hit the "Blog Website" deploy button on the
  Studio dashboard to rebuild. Nothing here needs editing by hand.
#}

<div class="container site-section main-section" style="text-align:center;">
    <h1 style="text-align:center;">Coin Show Schedule</h1>
    <p style="font-family:'Roboto'; font-size:18px; color:#444; max-width:700px; margin:0 auto 40px auto;">Come find us at these upcoming shows! Stop by the table to browse inventory, talk coins, or sell your collection in person.</p>

    {% for group in coinshows %}
    <div class="show-month-group" data-month="{{ group.key }}" style="margin-bottom:40px; max-width:800px; margin-left:auto; margin-right:auto;">
        <h2 style="font-family:'Noto Serif Display'; font-weight:800; color:#1d3961; font-size:22px; border-bottom:2px solid #e0e5ea; padding-bottom:8px; margin-bottom:16px; text-align:left;">{{ group.label }}</h2>
        <div style="display:flex; flex-direction:column; gap:12px;">

            {% for show in group.shows %}
            <div class="show-card{% if show.isPast %} is-past{% endif %}" data-end="{{ show.endISO }}">
                <div class="show-date-badge">
                    <div class="show-month-short">{{ show.monthShort }}</div>
                    <div class="show-day">{{ show.dayRange }}</div>
                </div>
                <div class="show-details">
                    {% if show.url %}
                    <a href="{{ show.url }}" target="_blank" rel="noopener" class="show-name-link">
                        <h3 class="show-name">{{ show.name }}</h3>
                    </a>
                    {% else %}
                    <h3 class="show-name">{{ show.name }}</h3>
                    {% endif %}
                    <div class="show-location">📍 {{ show.location }}</div>
                    <div class="show-meta">Table: {{ show.tableNumber }}</div>
                </div>
                <div class="show-badge-status {% if show.isPast %}is-past{% else %}is-upcoming{% endif %}">{% if show.isPast %}Past{% else %}Upcoming{% endif %}</div>
            </div>
            {% endfor %}

        </div>
    </div>
    {% endfor %}

    <p id="no-shows-message" style="font-family:'Roboto'; font-size:17px; color:#666; max-width:700px; margin:0 auto;" {% if coinshows.length %}hidden{% endif %}>
        Our next show schedule is being finalized — check back soon, or <a href="/contactus/">get in touch</a> and we'll let you know where to find us.
    </p>

</div>

<script>
(function () {
    // Mirrors the build-time rule in web/_data/coinshows.js so the page keeps
    // tidying itself between deploys. The static build only re-runs when the
    // site is rebuilt; without this, last month's shows would sit here until
    // the next publish. Kept deliberately in sync with retentionCutoff() there.
    var today = new Date();
    today.setHours(0, 0, 0, 0);
    var cutoff = new Date(today.getFullYear(), today.getMonth() - 1, 1);

    function parseYMD(value) {
        var parts = String(value || '').split('-');
        if (parts.length !== 3) return null;
        var d = new Date(+parts[0], +parts[1] - 1, +parts[2]);
        return isNaN(d.getTime()) ? null : d;
    }

    var visibleCount = 0;

    document.querySelectorAll('.show-card').forEach(function (card) {
        var endDate = parseYMD(card.dataset.end);
        if (!endDate) return;

        if (endDate < cutoff) {
            card.hidden = true;
            return;
        }
        visibleCount++;

        var isPast = endDate < today;
        var badge = card.querySelector('.show-badge-status');
        card.classList.toggle('is-past', isPast);
        if (badge) {
            badge.textContent = isPast ? 'Past' : 'Upcoming';
            badge.classList.toggle('is-past', isPast);
            badge.classList.toggle('is-upcoming', !isPast);
        }
    });

    // A month heading with every show expired underneath it should go too.
    document.querySelectorAll('.show-month-group').forEach(function (group) {
        var live = group.querySelectorAll('.show-card:not([hidden])');
        group.hidden = live.length === 0;
    });

    var empty = document.getElementById('no-shows-message');
    if (empty) empty.hidden = visibleCount > 0;
})();
</script>
