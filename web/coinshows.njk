{#
  The schedule below is driven entirely by the "Coin Shows" documents in Sanity
  Studio — see `web/_data/coinshows.js` for the query, month grouping and date
  formatting. Nothing here needs editing by hand.

  To take a past show off the page: unpublish it in Studio, then hit the "Blog
  Website" deploy button on the Studio dashboard. Same for adding or editing —
  changes are only live once that deploy runs. Shows do NOT expire on their own.
#}
<section class="cc26-pagehero cc26-pagehero--image" style="--hero-img: url('/assets/img/coinshow.jpg')">
    <div class="cc26-wrap cc26-pagehero__in">
        <div class="cc26-eyebrow">Coin show schedule</div>
        <h1>Come find us on the bourse floor.</h1>
        <p class="cc26-lede">Come find us at these upcoming shows! Stop by the table to browse inventory, talk coins, or sell your collection in person.</p>
    </div>
</section>

<section class="cc26-wrap cc26-section cc26-section--last cc26-showsched">
    <div class="cc26-showsched__list">
        {% for group in coinshows %}
        <div class="cc26-month" data-month="{{ group.key }}">
            <h2 class="cc26-month__label">{{ group.label }}</h2>
            <ul class="cc26-showlist">
                {% for show in group.shows %}
                <li class="cc26-show{% if show.isPast %} is-past{% endif %}" data-end="{{ show.endISO }}">
                    <div class="cc26-show__date">
                        <span class="cc26-show__mon">{{ show.monthShort }}</span>
                        <span class="cc26-show__days">{{ show.dayRange }}</span>
                    </div>
                    <div class="cc26-show__info">
                        <h3>{% if show.url %}<a href="{{ show.url }}" target="_blank" rel="noopener">{{ show.name }} <span aria-hidden="true">↗</span></a>{% else %}{{ show.name }}{% endif %}</h3>
                        <div class="cc26-show__meta">
                            <span>{{ show.location }}</span>
                            <span>Table: {{ show.tableNumber }}</span>
                        </div>
                    </div>
                    <span class="cc26-show__status">{% if show.isPast %}Past{% else %}Upcoming{% endif %}</span>
                </li>
                {% endfor %}
            </ul>
        </div>
        {% endfor %}

        <p class="cc26-lede" id="no-shows-message" {% if coinshows.length %}hidden{% endif %}>
            Our next show schedule is being finalized — check back soon, or <a href="/contactus/">get in touch</a> and we'll let you know where to find us.
        </p>
    </div>

    <aside class="cc26-showsched__side">
        <div class="cc26-sell__box">
            <div class="cc26-eyebrow">Selling at a show?</div>
            <p class="cc26-muted">Bring your coins to the table, or tell us what you have ahead of time and we'll be ready for you.</p>
            <a class="cc26-btn cc26-btn--outline" href="/selltous/">Tell us about your collection</a>
        </div>
        <div class="cc26-sell__box">
            <div class="cc26-eyebrow">Can't make a show?</div>
            <p class="cc26-muted">Join the list and be the first to see new coins the moment they land on the website.</p>
            <button type="button" class="cc26-btn cc26-btn--gold" data-join-open>Join the list</button>
        </div>
    </aside>
</section>

<script>
(function () {
    // Refreshes the Past / Upcoming tag against today's date. The build already rendered the correct
    // state; this only matters for a show that ends between deploys. Removing a past show stays a
    // manual step in Studio (unpublish, then redeploy) — no schedule logic lives here.
    var today = new Date();
    today.setHours(0, 0, 0, 0);
    document.querySelectorAll('.cc26-show').forEach(function (card) {
        var parts = String(card.dataset.end || '').split('-');
        if (parts.length !== 3) return;
        var endDate = new Date(+parts[0], +parts[1] - 1, +parts[2]);
        if (isNaN(endDate.getTime())) return;
        var isPast = endDate < today;
        card.classList.toggle('is-past', isPast);
        var tag = card.querySelector('.cc26-show__status');
        if (tag) tag.textContent = isPast ? 'Past' : 'Upcoming';
    });
})();
</script>
