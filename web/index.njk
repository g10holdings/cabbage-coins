{% set inStock = collections.listingsNewest | inStockNewest %}
{# hero = a ROTATION: the coins Tony switched on in Studio ("Homepage hero") + the 16 priciest in stock (ingots included).
   The page is built with the first one; the script under it swaps in a different one on every visit. #}
{% set heroList = collections.listingsNewest | heroPool(hero, featured, 16) %}
{% set heroPick = heroList[0] %}
{% set imgq = "&q=90&auto=format&fit=max" %}

{# ---------- Hero ---------- #}
<section class="cc26-wrap cc26-hero">
    <div class="cc26-hero__copy">
        <div class="cc26-eyebrow">Quality Rare Coins &amp; Ingots</div>
        <h1>Elevate the<br>Quality of<br>Your Collection.</h1>
        <p>Cabbage Coins buys and sells certified U.S. rare coins, gold and silver. Every coin is hand-picked, graded by PCGS, NGC or CAC, and photographed in-house so you see exactly what you get.</p>
        <div class="cc26-hero__ctas">
            <a class="cc26-btn cc26-btn--gold cc26-btn--lg" href="/inventory/">Browse the inventory</a>
            <a class="cc26-textlink" href="/selltous/">Sell your coins →</a>
        </div>
    </div>
    {% if heroPick %}
    <a class="cc26-hero__coin" id="cc26-hero-coin" href="/listings/{{ heroPick.slug.current | slug }}/">
        <img src="{{ heroPick.imageUrl }}?w=1100{{ imgq }}" alt="{{ heroPick.name }}" width="760" height="760">
        <span class="cc26-hero__caption">
            <span class="cc26-hero__name">{{ heroPick.name }}</span>
            <span class="cc26-hero__price">${{ heroPick.price | money }} →</span>
        </span>
    </a>
    {% if heroList.length > 1 %}
    {# Runs right away (before the photo loads) so visitors never see the coin switch. Picks at random,
       never the same coin twice in a row for the same visitor (remembered in their browser). #}
    <script>
    (function () {
        var pool = [{% for c in heroList %}{u:"/listings/{{ c.slug.current | slug }}/",i:{{ (c.imageUrl + "?w=1100" + imgq) | dump | safe }},n:{{ c.name | dump | safe }},p:"${{ c.price | money }} →"}{% if not loop.last %},{% endif %}{% endfor %}];
        var last = null; try { last = localStorage.getItem('cc26-hero'); } catch (e) {}
        var left = pool.filter(function (c) { return c.u !== last; });
        var c = left[Math.floor(Math.random() * left.length)];
        try { localStorage.setItem('cc26-hero', c.u); } catch (e) {}
        var a = document.getElementById('cc26-hero-coin'); if (!a) return;
        a.href = c.u;
        var img = a.querySelector('img'); img.src = c.i; img.alt = c.n;
        a.querySelector('.cc26-hero__name').textContent = c.n;
        a.querySelector('.cc26-hero__price').textContent = c.p;
    })();
    </script>
    {% endif %}
    {% endif %}
</section>

{# ---------- Trust strip (condensed to a 2×2 on phones; see site2026.css) ---------- #}
<section class="cc26-trust" aria-label="Why collectors trust us">
    <div class="cc26-wrap cc26-trust__grid">
        <a class="cc26-trust__item" href="#reviews">
            <span class="cc26-trust__big">{{ reviews.rating }} <span class="cc26-gold">★★★★★</span></span>
            <span class="cc26-trust__small cc26-gold">{{ reviews.count }} five-star Google reviews ↓</span>
        </a>
        <div class="cc26-trust__item">
            <span class="cc26-trust__big">PCGS · NGC · CAC</span>
            <span class="cc26-trust__small">Every coin independently certified</span>
        </div>
        <div class="cc26-trust__item">
            <span class="cc26-trust__big">ANA Life Member</span>
            <span class="cc26-trust__small">#7339 · Professional numismatist</span>
        </div>
        <a class="cc26-trust__item" href="/podcast/">
            <span class="cc26-trust__big">Weekly podcast</span>
            <span class="cc26-trust__small">Interviews with the hobby's experts</span>
        </a>
    </div>
</section>

{# ---------- New arrivals ---------- #}
<section class="cc26-wrap cc26-section">
    <div class="cc26-section__head">
        <div>
            <div class="cc26-eyebrow">New arrivals</div>
            <h2>Just added to the inventory</h2>
        </div>
        <a class="cc26-textlink" href="/inventory/">View the full inventory →</a>
    </div>
    <div class="cc26-grid">
        {% for listing in inStock %}{% if loop.index <= 12 %}
        <a class="cc26-card" href="/listings/{{ listing.slug.current | slug }}/">
            <span class="cc26-card__img">
                <img src="{{ listing.imageUrl }}?w=640{{ imgq }}" alt="{{ listing.name }}" loading="lazy">
                {% if listing.galleryImageUrl and listing.galleryImageUrl[0] %}
                <img class="cc26-card__back" src="{{ listing.galleryImageUrl[0] }}?w=640{{ imgq }}" alt="" loading="lazy">
                {% endif %}
            </span>
            <span class="cc26-card__meta">
                <span>{{ listing.gradingCompany }} {{ listing.grade | replace(" CAC", "") }}</span>
                {% if listing.cac %}<img src="/assets/img/caccoin.png" alt="CAC approved" class="cc26-cac">{% endif %}
            </span>
            <span class="cc26-card__name">{{ listing.name }}</span>
            <span class="cc26-card__price">${{ listing.price | money }}</span>
        </a>
        {% endif %}{% endfor %}
    </div>
</section>

{# ---------- Join the list (Tony's banner image) ---------- #}
<section class="cc26-pad">
    <div class="cc26-wrap">
        <div class="cc26-joinbanner">
            <span class="cc26-joinbanner__eyebrow">Heard us on the podcast? Start here.</span>
            <h2>Get first look at new coins</h2>
            <p>Signing up for the list ensures you are notified the moment new arrivals land on the website.</p>
            <button type="button" class="cc26-btn cc26-btn--gold cc26-btn--lg" data-join-open>Join the list</button>
        </div>
    </div>
</section>

{# ---------- Featured this week ---------- #}
{% if featured %}
{% set featuredFull = collections.listingsNewest | findListing(featured._id) %}
<section class="cc26-wrap cc26-section">
    <div class="cc26-featured">
        <a class="cc26-featured__photos" href="/listings/{{ featured.slug.current | slug }}/">
            <img src="{{ featured.imageUrl }}?w=700{{ imgq }}" alt="{{ featured.name }}, obverse">
            {% if featured.galleryImageUrl and featured.galleryImageUrl[0] %}<img src="{{ featured.galleryImageUrl[0] }}?w=700{{ imgq }}" alt="{{ featured.name }}, reverse">{% endif %}
            {% if featured.slabFront %}<img src="{{ featured.slabFront }}?w=700{{ imgq }}" alt="{{ featured.name }}, in its holder">{% endif %}
        </a>
        <div class="cc26-featured__copy">
            <div class="cc26-featured__main">
                <div class="cc26-eyebrow">★ Featured this week</div>
                <h2>{{ featured.name }}</h2>
                <div class="cc26-featured__grade">{{ featured.gradingCompany }} {{ featured.grade | replace(" CAC", "") }}{% if featured.cac %} <img src="/assets/img/caccoin.png" alt="CAC approved" class="cc26-cac"> {% endif %}</div>
                <div class="cc26-featured__buy">
                    <span class="cc26-featured__price">${{ featured.price | money }}</span>
                    <a class="cc26-btn cc26-btn--outline" href="/listings/{{ featured.slug.current | slug }}/">View this coin</a>
                </div>
            </div>
            {% if featuredFull and featuredFull.description %}
            <div class="cc26-featured__note">{{ featuredFull.description | markdownify | safe }}</div>
            {% endif %}
        </div>
    </div>
</section>
{% endif %}

