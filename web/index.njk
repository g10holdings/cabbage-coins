        </div>
    </div>
</section>

{# ---------- How we work ---------- #}
<section class="cc26-wrap cc26-section">
    <h2 class="cc26-h2">How we work with collectors</h2>
    <div class="cc26-ways">
        <a href="/inventory/"><span class="cc26-ways__n">01</span><span class="cc26-ways__t">Buy</span><span class="cc26-ways__d">Certified coins with full photography, population data and a straight answer to every question.</span><span class="cc26-ways__go">Browse inventory →</span></a>
        <a href="/selltous/"><span class="cc26-ways__n">02</span><span class="cc26-ways__t">Sell</span><span class="cc26-ways__d">Strong offers on rare coins, gold and silver, and prompt payment once your coins are inspected.</span><span class="cc26-ways__go">Get an offer →</span></a>
        <button type="button" data-join-open><span class="cc26-ways__n">03</span><span class="cc26-ways__t">Want list</span><span class="cc26-ways__d">Tell Tony what you are looking for. When the right coin comes in, you hear about it first.</span><span class="cc26-ways__go">Share your want list →</span></button>
    </div>
</section>

{# ---------- Podcast + shows ---------- #}
<section class="cc26-wrap cc26-section cc26-split">
    <div class="cc26-split__main">
        <div class="cc26-eyebrow">The Cabbage Coins Podcast</div>
        {% if podcast and podcast.length %}
        {# Click plays the episode right here (youtube-nocookie). Until then it's just a thumbnail, so the page stays fast. #}
        <button type="button" class="cc26-video" data-video="{{ podcast[0].videoId }}" aria-label="Play the latest episode: {{ podcast[0].title }}">
            <img src="{{ podcast[0].thumbnail }}" alt="" loading="lazy" onerror="this.onerror=null;this.src='https://i.ytimg.com/vi/{{ podcast[0].videoId }}/hqdefault.jpg'">
            <span class="cc26-video__badge">Latest episode</span>
            <span class="cc26-video__play" aria-hidden="true"><svg width="30" height="30" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg></span>
        </button>
        <a class="cc26-video__title" href="https://www.youtube.com/watch?v={{ podcast[0].videoId }}" target="_blank" rel="noopener">{{ podcast[0].title }}</a>
        <span class="cc26-muted">{{ podcast[0].publishedAt }}</span>
        {% else %}
        <a class="cc26-video cc26-video--empty" href="/podcast/">Watch the latest episodes →</a>
        {% endif %}
        <div class="cc26-linkrow">
            <a class="cc26-textlink" href="/podcast/">All episodes →</a>
            <button type="button" class="cc26-textlink cc26-gold" data-join-open>Listener? Join the list for first look at new coins →</button>
        </div>
    </div>
    <div class="cc26-split__side">
        <div class="cc26-eyebrow">Meet us in person</div>
        {% set shows = coinshows | upcomingShows(3) %}
        <ul class="cc26-shows">
            {% for s in shows %}
            <li>
                <span><span class="cc26-shows__name">{% if s.url %}<a href="{{ s.url }}" target="_blank" rel="noopener">{{ s.name }}</a>{% else %}{{ s.name }}{% endif %}</span><span class="cc26-muted">{{ s.location }}</span></span>
                <span class="cc26-gold cc26-nowrap">{{ s.monthShort }} {{ s.dayRange }}</span>
            </li>
            {% else %}
            <li><span class="cc26-muted">New shows are announced soon.</span></li>
            {% endfor %}
        </ul>
        <a class="cc26-textlink" href="/coinshows/">Full show schedule →</a>
    </div>
</section>

{# ---------- Reviews carousel ---------- #}
<section class="cc26-wrap cc26-section" id="reviews">
    <div class="cc26-section__head">
        <div>
            <div class="cc26-eyebrow">{{ reviews.rating }} ★★★★★ · {{ reviews.count }} reviews on Google</div>
            <h2>What collectors say</h2>
        </div>
        <div class="cc26-reviews__ctrl">
            {% if reviews.googleUrl %}<a class="cc26-textlink" href="{{ reviews.googleUrl }}" target="_blank" rel="noopener">Read them on Google ↗</a>{% endif %}
            <button type="button" class="cc26-iconbtn cc26-iconbtn--lg" data-rev-prev aria-label="Previous reviews">‹</button>
            <button type="button" class="cc26-iconbtn cc26-iconbtn--lg" data-rev-next aria-label="Next reviews">›</button>
        </div>
    </div>
    <div class="cc26-reviews" data-reviews tabindex="0" aria-label="Customer reviews, scroll sideways for more">
        {% for r in reviews.items %}
        <figure class="cc26-review">
            <span class="cc26-gold cc26-stars">★★★★★</span>
            <blockquote>“{{ r.q }}”</blockquote>
            <figcaption>{{ r.who }}</figcaption>
        </figure>
        {% endfor %}
    </div>
</section>

