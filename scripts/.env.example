# Copy this file to `.env` and fill in the values. Do NOT commit `.env`.

# Sanity write token — create at https://manage.sanity.io
#   → project "cabbage-coins" (la880an7) → API → Tokens → Add token → "Editor" permission.
# Needs create/write access so the script can add draft documents.
SANITY_WRITE_TOKEN=""

# Anthropic API key for generating the Alternative Text (image alt) field.
# Not needed if you run with --no-alt.
ANTHROPIC_API_KEY=""

# Optional overrides (defaults shown). Usually leave these alone.
# SANITY_PROJECT_ID="la880an7"
# SANITY_DATASET="production"
